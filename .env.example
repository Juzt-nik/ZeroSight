# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security
SECRET_KEY=replace-with-strong-secret-min-32-chars
ENCRYPTION_KEY=replace-with-strong-32-byte-base64-key
AUTH_SECRET=replace-with-strong-auth-secret-min-32-chars
TOKEN_SECRET=replace-with-strong-token-secret-min-32-chars

# Location minimization: none | coarsen | withhold
LOCATION_MINIMIZATION_LEVEL=coarsen
LOCATION_GRID_SIZE_KM=1

# Dual approval
UNAMASK_REQUEST_TTL_MINUTES=30
REQUIRED_APPROVERS=2

# Audit
AUDIT_DB_PATH=/app/data/audit.db
AUDIT_HASH_CHAIN_ENABLED=true

# Dataset paths (mounted via docker compose)
DATASET_DIR=/app/data/raw
DATASET_MAX_INVALID_ROW_RATE=0.001
MODEL_DIR=/app/models

# Provide a persistent host key at this path; compose mounts it into the container.
AUDIT_CHECKPOINT_KEY_PATH=/run/secrets/audit_checkpoint_key.pem

# IBM Z (documentation only - not used by application code)
IBM_Z_PLATFORM=s390x
IBM_Z_SECURE_EXECUTION=false
IBM_Z_CRYPTO_EXPRESS=false
